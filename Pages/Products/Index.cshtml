@page
@model wt_lab5_5razor_kobzeva.Pages.Products.IndexModel

@{
    ViewData["Title"] = "Объекты недвижимости";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">🏠 Каталог недвижимости</h1>
            <p class="text-muted">Агентство недвижимости — УИР-1, Кобзева Виктория</p>
            <p class="text-secondary">Количество объектов: <strong>@Model.Properties.Count</strong></p>
        </div>
        <a asp-page="/Products/Create" class="btn btn-primary btn-lg">
            ➕ Добавить объект
        </a>
    </div>

    @if (Model.Properties.Count == 0)
    {
        <div class="alert alert-info">Список пуст. Добавьте первый объект.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var property in Model.Properties)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4 border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-secondary">ID: @property.Id</span>
                                <span class="badge bg-info text-dark">@property.Type</span>
                                @if (property.IsAvailable)
                                {
                                    <span class="badge bg-success">Доступен</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Недоступен</span>
                                }
                            </div>
                            <h5 class="card-title fw-bold">@property.Address</h5>
                            <p class="text-muted mb-2">
                                📐 @property.Area м² · 🚪 @property.Rooms комн.
                            </p>
                            <p class="fs-4 fw-bold text-primary mt-auto">
                                @property.Price.ToString("N0") BYN
                            </p>
                            <div class="d-flex flex-column gap-2 mt-auto">
    <div class="d-flex gap-2">
        <a asp-page="/Products/Details" asp-route-id="@property.Id" class="btn btn-outline-primary flex-fill">
            Подробнее
        </a>
        <a asp-page="/Products/Edit" asp-route-id="@property.Id" class="btn btn-outline-secondary">
            ✏️
        </a>
    </div>
    <form method="post" asp-page-handler="Delete" asp-route-id="@property.Id" onsubmit="return confirm('Вы уверены, что хотите удалить этот объект?');">
        <button type="submit" class="btn btn-outline-danger w-100">
            🗑️ Удалить
        </button>
    </form>
</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>